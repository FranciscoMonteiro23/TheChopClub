<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Chop Club</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    <i class="bi bi-scissors text-warning"></i> THE CHOP CLUB
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index">
                                <i class="bi bi-house"></i> Início
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Ranking">
                                <i class="bi bi-trophy"></i> Ranking
                            </a>
                        </li>

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            var userRole = Context.Session.GetString("UserRole");

                            @if (userRole == "Barber" || userRole == "1")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Barber/Dashboard">
                                        <i class="bi bi-graph-up"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Post/Create">
                                        <i class="bi bi-plus-circle"></i> Nova Publicação
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Profile/Edit"><i class="bi bi-person"></i>
                                        Perfil</a></li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li><a class="dropdown-item" asp-page="/Account/Logout"><i
                                            class="bi bi-box-arrow-right"></i> Sair</a></li>
                                        </ul>
                                    </li>
                                }
                        else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-page="/Account/Login">
                                            <i class="bi bi-box-arrow-in-right"></i> Entrar
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link btn btn-warning text-dark ms-2" asp-page="/Account/Register">
                                            <i class="bi bi-person-plus"></i> Registar
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>

            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <footer class="bg-dark text-white mt-5">
                <div class="container py-5">
                    <div class="row">
                        <!-- Sobre o The Chop Club -->
                        <div class="col-lg-3 col-md-6 mb-4">
                            <h5 class="text-warning mb-3">
                                <i class="bi bi-scissors"></i> THE CHOP CLUB
                            </h5>
                            <p class="small">
                                A plataforma exclusiva que conecta barbeiros profissionais com clientes
                                que valorizam a arte e a excelência.
                            </p>
                            <p class="small mb-0">
                                <strong>Porto, Portugal</strong>
                            </p>

                            <!-- Ícones de Redes Sociais -->
                            <div class="mt-3">
                            </div>
                        </div>

                        <!-- Navegação -->
                        <div class="col-lg-3 col-md-6 mb-4">
                            <h5 class="text-warning mb-3">
                                <i class="bi bi-link-45deg"></i> NAVEGAÇÃO
                            </h5>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <a asp-page="/Index" class="text-white text-decoration-none">
                                        <i class="bi bi-chevron-right"></i> Página Inicial
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a asp-page="/Account/Register" class="text-white text-decoration-none">
                                        <i class="bi bi-chevron-right"></i> Criar Conta
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a asp-page="/Account/Login" class="text-white text-decoration-none">
                                        <i class="bi bi-chevron-right"></i> Login
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a href="#" class="text-white text-decoration-none">
                                        <i class="bi bi-chevron-right"></i> Sobre Nós
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Para Barbeiros -->
                        <div class="col-lg-3 col-md-6 mb-4">
                            <h5 class="text-warning mb-3">
                                <i class="bi bi-scissors"></i> PARA BARBEIROS
                            </h5>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <a asp-page="/Premium" class="text-white text-decoration-none">
                                        <i class="bi bi-crown"></i> Plano Premium
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a asp-page="/Barber/Dashboard" class="text-white text-decoration-none">
                                        <i class="bi bi-graph-up"></i> Dashboard
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a href="#" class="text-white text-decoration-none">
                                        <i class="bi bi-shop"></i> Abrir Loja
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a href="#" class="text-white text-decoration-none">
                                        <i class="bi bi-people"></i> Comunidade
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Suporte -->
                        <div class="col-lg-3 col-md-6 mb-4">
                            <h5 class="text-warning mb-3">
                                <i class="bi bi-headset"></i> SUPORTE
                            </h5>
                            <ul class="list-unstyled small">
                                <li class="mb-2">
                                    <i class="bi bi-envelope"></i>
                                    <a href="mailto:suporte@chopclub.com" class="text-white text-decoration-none">
                                        suporte@chopclub.com
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-telephone"></i>
                                    <a href="tel:+351910000000" class="text-white text-decoration-none">
                                        +351 910 000 000
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-clock"></i> Seg-Sex: 9h-18h
                                </li>
                                <li class="mb-2">
                                    <a href="#" class="text-white text-decoration-none">
                                        <i class="bi bi-question-circle"></i> FAQ
                                    </a>
                                </li>
                                <li class="mb-2">
                                    <a href="#" class="text-white text-decoration-none">
                                        <i class="bi bi-file-text"></i> Termos de Uso
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Copyright -->
                    <hr class="border-secondary">
                    <div class="row">
                        <div class="col-12 text-center">
                            <p class="mb-0 small">
                                © 2026 <strong>The Chop Club</strong>. Todos os direitos reservados.
                            </p>
                        </div>
                    </div>
                </div>
            </footer>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>

            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>
